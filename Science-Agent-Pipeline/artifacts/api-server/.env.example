# Terrium Science Agent Pipeline - Environment Configuration Example
# Copy this file to .env and update values for your deployment

# ============================================================================
# CORE SERVER
# ============================================================================

# Port the API server listens on. Required.
PORT=3000

# Node environment (development, test, production). Affects logging verbosity.
NODE_ENV=development

# Logging level: error, warn, info, debug, trace
LOG_LEVEL=info

# ============================================================================
# PYTHON BRIDGE
# ============================================================================

# Path to Python 3.10+ executable (optional; auto-detected if unset).
# Supports 3.10, 3.11, 3.12, 3.13.
# If set, overrides VIRTUAL_ENV and PATH discovery.
TERRIUM_PYTHON=/usr/bin/python3.12

# Virtual environment path (optional; checked if TERRIUM_PYTHON unset).
# If set, uses $VIRTUAL_ENV/bin/python
VIRTUAL_ENV=/path/to/venv

# ============================================================================
# LLM CONFIGURATION
# Three options: (1) predefined provider, (2) generic OpenAI-compatible, (3) none
# ============================================================================

# Option 1: Use a predefined provider (groq, openrouter, mistral, siliconflow, tokenrouter)
# If set, LLM_PROVIDER selects from the list below; the corresponding
# PROVIDER_API_KEY is used as the bearer token.
LLM_PROVIDER=groq

# Provider-specific API keys (use whichever provider is selected above).
# Only one of these should be populated; the selected LLM_PROVIDER will use its key.
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=your-openrouter-key
MISTRAL_API_KEY=your-mistral-key
SILICONFLOW_API_KEY=your-siliconflow-key
TOKENROUTER_API_KEY=your-tokenrouter-key

# Option 2: Generic OpenAI-compatible endpoint (overrides LLM_PROVIDER if set)
# Use these to point at any OpenAI-compatible API (local llama.cpp, Ollama, etc.)
LLM_API_KEY=your-api-key
LLM_API_URL=https://api.example.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Option 2 (OpenAI-specific, only used if LLM_PROVIDER/LLM_API_KEY unset)
# If neither LLM_PROVIDER nor LLM_API_KEY are set, falls back to OpenAI defaults.
OPENAI_API_KEY=your-openai-key
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Force JSON mode on providers that don't support it (true/false).
# Defaults to false for providers known not to support it (SiliconFlow).
# Set to true to force json_object response format even if provider doesn't natively support it.
LLM_FORCE_JSON=false

# ============================================================================
# CACHING
# ============================================================================

# Path to cache file (optional; defaults to ./data/cache.json).
# Used by the in-memory job cache for rapid restores on restart.
CACHE_FILE=/path/to/cache.json

# ============================================================================
# DATA PERSISTENCE
# ============================================================================

# Path to waitlist file (optional; defaults to ./data/waitlist.json).
# JSON file storing email signup list.
WAITLIST_FILE=/path/to/waitlist.json

# ============================================================================
# SECURITY
# ============================================================================

# Admin token for POST /api/metrics/reset endpoint.
# Bearer token scheme: Authorization: Bearer <METRICS_ADMIN_TOKEN>
# If unset, the endpoint returns 501 (Not Implemented).
METRICS_ADMIN_TOKEN=your-secure-random-token-here

# ============================================================================
# NOTES
# ============================================================================

# - PORT is required; the server will not start without it.
# - For LLM: exactly one of LLM_PROVIDER or (LLM_API_KEY + LLM_API_URL) should be set.
# - If no LLM is configured, the pipeline falls back to keyword-based domain detection.
# - METRICS_ADMIN_TOKEN should be a high-entropy random value in production.
# - LOG_LEVEL only affects the api-server; the Python engine has its own logging.
