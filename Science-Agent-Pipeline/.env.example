# Copy this file to .env and fill in real values.
#
# ============================================================================
# THIS FILE IS COMMITTED. THE REAL KEYS GO IN .env, WHICH IS NOT.
# ============================================================================
#
# `.env` is ignored by Science-Agent-Pipeline/.gitignore (line 66, `*.env`) --
# confirm with `git check-ignore -v Science-Agent-Pipeline/.env`. This file,
# .env.example, IS tracked, so a real key pasted below is a key pushed to the
# remote and scraped off it: GitHub is crawled continuously for exactly this,
# and a leaked free-tier key is usually drained within the hour.
#
# So every value here is a placeholder or empty, on purpose. If you are
# looking at a populated .env.example, something has gone wrong -- rotate
# those keys before doing anything else.
#
# ============================================================================
# THE ACCOUNT BEHIND EVERY KEY
# ============================================================================
#
# All provider accounts are registered to admin.terrium@gmail.com. That is
# recorded here because a key with no known owner cannot be rotated: when one
# of these leaks or expires, whoever is on call needs to know which inbox the
# reset link goes to without having to guess.
#
# ============================================================================
# NOTHING HERE IS REQUIRED
# ============================================================================
#
# Every resolver that reads one of these degrades gracefully to its
# unauthenticated behaviour when the variable is unset -- see the docstring in
# each module named below. They raise rate limits or add a fallback source;
# they do not gate functionality.
#
# The one thing they never do is supply a parameter VALUE. See the LLM section.


# ============================================================================
# LITERATURE SOURCES
# ============================================================================

# NCBI E-utilities (Tests/enzyme_lookup.py, Tests/fallback_logic.py).
# Free: https://www.ncbi.nlm.nih.gov/account/settings/ -> "API Key Management".
# Account: admin.terrium@gmail.com
# Without it, PubMed/Taxonomy calls are capped at 3 req/sec per IP; with it,
# 10 req/sec.
NCBI_API_KEY=

# CORE API (Tests/core_fulltext.py).
# Free but REQUIRED for this source: CORE's v3 search API has no
# unauthenticated tier, so without this key resolve_open_access_fulltext()
# always returns found=False. That is a real reduction in coverage, not a
# slowdown.
# https://core.ac.uk/services/api/ -> "Get your API key".
# Account: admin.terrium@gmail.com
CORE_API_KEY=


# ============================================================================
# LLM PROVIDERS -- FOR LANGUAGE TASKS ONLY
# ============================================================================
#
# READ THIS BEFORE ADDING A PROVIDER.
#
# These keys drive ENTITY EXTRACTION and DOMAIN CLASSIFICATION in
# artifacts/api-server/src/lib/llmResolver.ts: turning a typed sentence into
# an enzyme name, a substrate, an organism, and a domain label. Those are
# language tasks and a language model is the right tool for them.
#
# An LLM is NEVER a source for a parameter VALUE. ADR 0011 -- "An LLM-supplied
# parameter is its own origin, not a `default`", amended 2026-08-06 to
# "resolver now hard-blocks `llm`" -- is the rule, and it is the reason this
# project is worth anything to a lab. A Km that came out of a language model
# is not a measurement. The code used to label such values `origin: "default"`,
# which is a false statement at the API surface, and that is what the ADR
# closed.
#
# Adding capacity below does not widen what an LLM is allowed to decide.

# -- Option 1: one named provider -------------------------------------------
#
# Set LLM_PROVIDER to one of: openai, groq, openrouter, mistral, siliconflow,
# tokenrouter. The matching key below is used as the bearer token.
LLM_PROVIDER=

# groq -- https://console.groq.com/keys
# Account: admin.terrium@gmail.com
# Free tier. Reports its own remaining quota on every call
# (x-ratelimit-remaining-requests / -tokens, and reset timers), documented at
# https://console.groq.com/docs/rate-limits -- which is why the waterfall can
# know Groq's headroom before a call fails rather than after.
GROQ_API_KEY=

# openrouter -- https://openrouter.ai/keys
# Account: admin.terrium@gmail.com
# Free models carry a `:free` suffix. Documented limits
# (https://openrouter.ai/docs/api-reference/limits): 20 requests/minute and
# 50/day with no credit purchased, 1000/day once $10 has been bought
# lifetime. Remaining credit is readable from GET /api/v1/key; rate-limit
# headers appear on ERROR responses rather than on every call.
OPENROUTER_API_KEY=

# mistral -- https://console.mistral.ai/api-keys
# Account: admin.terrium@gmail.com
# Free tier available. Its rate-limit headers were not read when the
# waterfall was written, so quota.py holds no header names for it and treats
# its headroom as UNKNOWN rather than assuming it copies another provider's
# scheme. That is deliberate: a guessed header name produces a confident
# misreading.
MISTRAL_API_KEY=

# siliconflow -- https://cloud.siliconflow.com/account/ak
# Account: admin.terrium@gmail.com
# NOTE: llmResolver.ts records supportsJsonMode: false for this provider, so
# response_format:json_object is not sent to it. Overriding that with
# LLM_FORCE_JSON below will make it fail rather than comply.
SILICONFLOW_API_KEY=

# tokenrouter -- https://tokenrouter.io
# Account: admin.terrium@gmail.com
# Itself a router over other providers, which makes it the sensible LAST link
# in the waterfall: when TokenRouter fails, everything behind it has failed.
TOKENROUTER_API_KEY=

# openai (the default when LLM_PROVIDER is unset)
# Account: admin.terrium@gmail.com
# Paid. Left empty by default: an unset OPENAI_API_KEY makes the LLM path
# report unavailable, which is the honest state, whereas a populated one
# starts spending money on a path that is optional.
OPENAI_API_KEY=

# -- Option 2: any OpenAI-compatible endpoint -------------------------------
#
# Works regardless of LLM_PROVIDER, and an explicit LLM_API_URL always wins
# over a named provider's default URL. Use it for a local llama.cpp or
# Ollama, or -- the intended use -- for the LiteLLM waterfall below.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# Force (true) or disable (false) response_format:json_object regardless of
# the selected provider's known support. Leave unset to use each provider's
# checked default (LLM_PROVIDERS in llmResolver.ts).
LLM_FORCE_JSON=


# ============================================================================
# THE LITELLM WATERFALL (optional, and the reason the keys above are plural)
# ============================================================================
#
# artifacts/llm-gateway/ runs a LiteLLM proxy in front of every provider
# above, so one key running out moves to the next instead of failing. Set it
# up with:
#
#   pip install 'litellm[proxy]'
#   export LITELLM_MASTER_KEY=$(openssl rand -hex 32)
#   litellm --config Science-Agent-Pipeline/artifacts/llm-gateway/config.yaml
#
# then point the generic override at it -- no application code changes,
# because Option 2 above already accepts any OpenAI-compatible endpoint:
#
#   LLM_API_URL=http://127.0.0.1:4000/v1/chat/completions
#   LLM_API_KEY=$LITELLM_MASTER_KEY
#   LLM_MODEL=terrium-extract
#
# litellm is NOT in requirements.txt: nothing else in this repository needs
# it, and the gateway is an optional deployment rather than a dependency of
# the engine.

# The proxy's own key. REQUIRED when the gateway runs, with no default on
# purpose -- a master key with a default value is a master key everybody has,
# and an open port on a laptop would otherwise be an open relay to five
# upstream accounts. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=

# Where the waterfall persists per-provider quota state. Counters and reset
# times only -- no keys, no prompts, no responses. Safe to delete; the
# gateway relearns from response headers, at a cost of one wasted 429 per
# provider. Defaults to artifacts/llm-gateway/.quota.json when unset.
TERRIUM_QUOTA_LEDGER=
