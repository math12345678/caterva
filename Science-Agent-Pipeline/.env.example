# Copy this file to .env and fill in real values. .env is gitignored
# (Science-Agent-Pipeline/.gitignore's `.env*` / `*.env` patterns) --
# never commit real keys.
#
# Nothing in this project REQUIRES any of these to function: every
# resolver that reads one degrades gracefully to its unauthenticated /
# unavailable behavior when the variable is unset (see the docstring in
# each module named below). They exist to raise rate limits or add a
# fallback source, not to gate functionality.

# NCBI E-utilities (Tests/enzyme_lookup.py, Tests/fallback_logic.py).
# Free: https://www.ncbi.nlm.nih.gov/account/settings/ -> "API Key
# Management". Without this, PubMed/Taxonomy calls are capped at 3
# req/sec per IP; with it, 10 req/sec.
NCBI_API_KEY=

# CORE API (Tests/core_fulltext.py). Free but required -- CORE's v3
# search API has no unauthenticated tier, so without this key,
# resolve_open_access_fulltext() always returns found=False.
# https://core.ac.uk/services/api/ -> "Get your API key".
CORE_API_KEY=

# LLM entity-extraction backend (Science-Agent-Pipeline/artifacts/api-
# server/src/lib/llmResolver.ts). NOT a literature/citation source --
# see ADR 0011: an LLM-supplied parameter is its own provenance origin
# ("llm"), never treated as "resolved" the way a BRENDA/PubMed value is.
#
# Set LLM_PROVIDER to one of the names below plus that provider's own key
# variable, OR skip LLM_PROVIDER entirely and use the generic
# OPENAI_API_KEY/LLM_API_KEY + LLM_API_URL + LLM_MODEL override (works
# with literally any OpenAI-compatible endpoint, including ones not
# listed here) -- either path works, and an explicit LLM_API_URL always
# wins over a selected provider's default URL.
LLM_PROVIDER=

# openai (LLM_PROVIDER=openai, the default when LLM_PROVIDER is unset)
OPENAI_API_KEY=

# groq (LLM_PROVIDER=groq) -- https://console.groq.com/keys
GROQ_API_KEY=

# openrouter (LLM_PROVIDER=openrouter) -- https://openrouter.ai/keys
OPENROUTER_API_KEY=

# mistral (LLM_PROVIDER=mistral) -- https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# siliconflow (LLM_PROVIDER=siliconflow) -- https://cloud.siliconflow.com/account/ak
SILICONFLOW_API_KEY=

# tokenrouter (LLM_PROVIDER=tokenrouter) -- https://tokenrouter.io
TOKENROUTER_API_KEY=

# Generic override, works regardless of LLM_PROVIDER:
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
# Force (true) or disable (false) response_format:json_object regardless
# of the selected provider's known support for it. Leave unset to use
# each provider's checked default (see LLM_PROVIDERS in llmResolver.ts).
LLM_FORCE_JSON=
