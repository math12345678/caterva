# Copy this file to .env and fill in real values. .env is gitignored
# (Science-Agent-Pipeline/.gitignore's `.env*` / `*.env` patterns) --
# never commit real keys.
#
# Nothing in this project REQUIRES any of these to function: every
# resolver that reads one degrades gracefully to its unauthenticated /
# unavailable behavior when the variable is unset (see the docstring in
# each module named below). They exist to raise rate limits or add a
# fallback source, not to gate functionality.

# NCBI E-utilities (Tests/enzyme_lookup.py, Tests/fallback_logic.py).
# Free: https://www.ncbi.nlm.nih.gov/account/settings/ -> "API Key
# Management". Without this, PubMed/Taxonomy calls are capped at 3
# req/sec per IP; with it, 10 req/sec.
NCBI_API_KEY=

# CORE API (Tests/core_fulltext.py). Free but required -- CORE's v3
# search API has no unauthenticated tier, so without this key,
# resolve_open_access_fulltext() always returns found=False.
# https://core.ac.uk/services/api/ -> "Get your API key".
CORE_API_KEY=

# LLM entity-extraction backend (Science-Agent-Pipeline/artifacts/api-
# server/src/lib/llmResolver.ts). NOT a literature/citation source --
# see ADR 0011: an LLM-supplied parameter is its own provenance origin
# ("llm"), never treated as "resolved" the way a BRENDA/PubMed value is.
# Any OpenAI-compatible endpoint works; only one of these is needed.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
