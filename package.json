{
  "name": "terrium-scientific-backend",
  "version": "0.3.3",
  "description": "Production-ready scientific validation and reproducibility framework. Unaffiliated with Tellurium.",
  "main": "src/integration/scientificPipeline.ts",
  "bin": {
    "scientific": "src/cli/scientificCLI.ts"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "cli": "ts-node src/cli/scientificCLI.ts",
    "cli:help": "ts-node src/cli/scientificCLI.ts help",
    "cli:validate": "ts-node src/cli/scientificCLI.ts validate",
    "cli:simulate": "ts-node src/cli/scientificCLI.ts simulate",
    "cli:literature": "ts-node src/cli/scientificCLI.ts literature",
    "example": "ts-node examples/scientificPipelineExample.ts",
    "dev": "ts-node --watch src/cli/scientificCLI.ts",
    "web": "node dist/src/web/server.js",
    "web:dev": "ts-node src/web/server.ts",
    "web:start": "npm run build && npm run web",
    "verify-all": "npm run type-check && npm run lint && npm test",
    "generate:client:ts": "bash scripts/generate-client.sh typescript",
    "generate:client:python": "bash scripts/generate-client.sh python",
    "generate:client:go": "bash scripts/generate-client.sh go",
    "generate:client:rust": "bash scripts/generate-client.sh rust",
    "generate:client": "bash scripts/generate-client.sh"
  },
  "keywords": [
    "science",
    "validation",
    "reproducibility",
    "literature",
    "enzyme-kinetics",
    "michaelis-menten"
  ],
  "author": "Terrium Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "express": "^4.22.2",
    "jest": "^29.5.0",
    "js-yaml": "^4.3.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testTimeout": 30000,
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/cli/**",
      "!src/logger.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
