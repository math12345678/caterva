# What the source distribution carries beyond the package itself.
#
# Setuptools' defaults swept the whole literature layer in: its sdist glob
# includes `tests/`, and on a case-folding filesystem that matched `Tests/`
# -- 81 files that are not part of the installable package and whose
# fixtures are covered by a licence carve-out (see LICENSE) that a
# redistributed copy would have to carry with it. Pruned explicitly, in
# both spellings, so the result does not depend on the filesystem the
# build ran on.
include LICENSE NOTICE README.md CHANGELOG.md CITATION.cff pyproject.toml
prune Tests
prune tests
prune caterva/tests
prune caterva/.pytest_cache
prune caterva/.hypothesis
exclude caterva/conftest.py caterva/pytest.ini caterva/.coverage
global-exclude __pycache__ *.py[cod] .DS_Store
include caterva/core/data/*.json caterva/core/data/README.md
include caterva/enzymes/data/enzyme_index.json.gz caterva/enzymes/data/protein_names.json.gz caterva/enzymes/data/symbols.json caterva/enzymes/data/NOTICE.txt
# The literature layer's import closure, copied out of Tests/ by
# scripts/vendor_literature.py (which build_release.py runs first). Code only:
# no fixture and no recorded answer goes with it.
include caterva/_literature/*.py caterva/_literature/README.txt
