<?xml version="1.0" encoding="UTF-8"?>
<!--
  SOURCE
  Lineage captured 2026-08-13 from the NCBI Taxonomy browser
  (https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=5807).
  Taxon ids, scientific names and ranks are reproduced exactly as NCBI
  served them, including ranks that look unusual ("cellular root",
  "domain" where older records said "superkingdom", and the kingdom-level
  bacterial names NCBI introduced in its recent revisions).

  STRUCTURE
  Wrapped in NCBI's eFetch taxonomy XML shape (TaxaSet/Taxon/LineageEx)
  so that taxonomy.parse_taxon_lineage is exercised against the format it
  will actually receive at runtime. The wrapper is reconstructed; the
  lineage content is captured. That distinction is stated here rather than
  left to be discovered, because a fixture that quietly mixes captured and
  invented data is exactly the failure this project is about.

  NCBI Taxonomy data is produced by the National Center for Biotechnology
  Information, U.S. National Library of Medicine, and is in the public
  domain. See NOTICE at the repository root.

  DO NOT hand-edit. Regenerate from the capture if NCBI's taxonomy changes.
-->
<TaxaSet>
  <Taxon>
    <TaxId>5807</TaxId>
    <ScientificName>Cryptosporidium parvum</ScientificName>
    <ParentTaxId>5806</ParentTaxId>
    <Rank>species</Rank>
    <Lineage>cellular organisms; Eukaryota; Sar; Alveolata; Apicomplexa; Conoidasida; Coccidia; Eucoccidiorida; Eimeriorina; Cryptosporidiidae; Cryptosporidium</Lineage>
    <LineageEx>
      <Taxon><TaxId>131567</TaxId><ScientificName>cellular organisms</ScientificName><Rank>cellular root</Rank></Taxon>
      <Taxon><TaxId>2759</TaxId><ScientificName>Eukaryota</ScientificName><Rank>domain</Rank></Taxon>
      <Taxon><TaxId>2698737</TaxId><ScientificName>Sar</ScientificName><Rank>no rank</Rank></Taxon>
      <Taxon><TaxId>33630</TaxId><ScientificName>Alveolata</ScientificName><Rank>no rank</Rank></Taxon>
      <Taxon><TaxId>5794</TaxId><ScientificName>Apicomplexa</ScientificName><Rank>phylum</Rank></Taxon>
      <Taxon><TaxId>1280412</TaxId><ScientificName>Conoidasida</ScientificName><Rank>class</Rank></Taxon>
      <Taxon><TaxId>5796</TaxId><ScientificName>Coccidia</ScientificName><Rank>subclass</Rank></Taxon>
      <Taxon><TaxId>75739</TaxId><ScientificName>Eucoccidiorida</ScientificName><Rank>order</Rank></Taxon>
      <Taxon><TaxId>423054</TaxId><ScientificName>Eimeriorina</ScientificName><Rank>suborder</Rank></Taxon>
      <Taxon><TaxId>35082</TaxId><ScientificName>Cryptosporidiidae</ScientificName><Rank>family</Rank></Taxon>
      <Taxon><TaxId>5806</TaxId><ScientificName>Cryptosporidium</ScientificName><Rank>genus</Rank></Taxon>
    </LineageEx>
  </Taxon>
</TaxaSet>
